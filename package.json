{
  "name": "@myles-garden/utils",
  "version": "0.0.0-development",
  "description": "Shared utilities for myles.garden.",
  "homepage": "https://github.com/myles/myles-garden-utils#readme",
  "bugs": {
    "url": "https://github.com/myles/myles-garden-utils/issues"
  },
  "license": "MIT",
  "author": "Myles Braithwaite <myles@myles.garden> (https://myles.garden)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myles/myles-garden-utils.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./array": "./dist/array.mjs",
    "./date": "./dist/date.mjs",
    "./text": "./dist/text.mjs",
    "./zod": "./dist/zod.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check:fix": "npm run check -- --fix",
    "dev": "vp pack --watch",
    "prepare": "vp config",
    "prepublishOnly": "vp run build",
    "test": "vp test",
    "isbn-ranges:update": "node scripts/isbn-ranges-update.ts && vp fmt src/text/isbnRanges.ts"
  },
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@mylesb/oxfmt-config": "^1.0.0",
    "@mylesb/oxlint-config": "^1.0.0",
    "@types/node": "^26.1.1",
    "date-fns": "^4.4.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@date-fns/tz": "^1.0.0",
    "date-fns": "^4.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@date-fns/tz": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
